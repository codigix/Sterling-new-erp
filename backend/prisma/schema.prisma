  vendors          vendors                         @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "vendor_payments_ibfk_2")

  @@index([invoice_id], map: "invoice_id")
  @@index([vendor_id], map: "vendor_id")
}

model vendors {
  id                                      Int                           @id @default(autoincrement())
  name                                    String                        @db.VarChar(255)
  email                                   String                        @unique(map: "email") @db.VarChar(255)
  address                                 String?                       @db.Text
  category                                String?                       @db.VarChar(100)
  rating                                  Decimal?                      @default(0.00) @db.Decimal(3, 2)
  created_at                              DateTime?                     @default(now()) @db.Timestamp(0)
  updated_at                              DateTime?                     @default(now()) @db.Timestamp(0)
  vendor_code                             String?                       @unique(map: "vendor_code") @db.VarChar(50)
  contact_person_name                     String?                       @db.VarChar(255)
  designation                             String?                       @db.VarChar(100)
  mobile_number                           String?                       @db.VarChar(50)
  vendor_type                             vendors_vendor_type?          @default(material_supplier)
  status                                  vendors_status?               @default(active)
  city                                    String?                       @db.VarChar(100)
  state                                   String?                       @db.VarChar(100)
  pincode                                 String?                       @db.VarChar(20)
  gstin                                   String?                       @db.VarChar(20)
  pan_number                              String?                       @db.VarChar(20)
  msme_category                           vendors_msme_category?        @default(none)
  msme_certificate                        String?                       @db.VarChar(255)
  payment_terms                           vendors_payment_terms?        @default(net_30)
  credit_limit                            Decimal?                      @default(0.00) @db.Decimal(15, 2)
  bank_name                               String?                       @db.VarChar(255)
  account_number                          String?                       @db.VarChar(100)
  ifsc_code                               String?                       @db.VarChar(20)
  average_lead_time                       Int?                          @default(0)
  preferred_vendor                        Boolean?                      @default(false)
  notes                                   String?                       @db.Text
  department                              String?                       @default("procurement") @db.VarChar(50)
  grns_grns_vendor_idTovendors            grns[]                        @relation("grns_vendor_idTovendors")
  grns_grns_inspection_vendor_idTovendors grns[]                        @relation("grns_inspection_vendor_idTovendors")
  purchase_orders                         purchase_orders[]
  quality_inspection_challans             quality_inspection_challans[]
  quotations                              quotations[]
  vendor_invoices                         vendor_invoices[]
  vendor_payments                         vendor_payments[]
}

model warehouses {
  id         Int       @id @default(autoincrement())
  name       String    @unique(map: "name") @db.VarChar(255)
  type       String?   @default("Warehouse") @db.VarChar(100)
  location   String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model audit_logs {
  id         Int                @id @default(autoincrement())
  user_name  String             @db.VarChar(255)
  action     String             @db.VarChar(255)
  type       audit_logs_type
  details    String?            @db.Text
  ip_address String?            @db.VarChar(45)
  status     audit_logs_status? @default(success)
  created_at DateTime?          @default(now()) @db.Timestamp(0)
}

model financial_reminders {
  id               Int       @id @default(autoincrement())
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  reminder_date    DateTime  @db.Date
  email            String    @db.VarChar(255)
  recurrence       String?   @default("once") @db.VarChar(50)
  recurrence_day   Int?
  recurrence_month Int?
  is_triggered     Boolean?  @default(false)
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  updated_at       DateTime? @default(now()) @db.Timestamp(0)
}

model password_reset_requests {
  id         Int                             @id @default(autoincrement())
  user_id    Int
  username   String                          @db.VarChar(255)
  full_name  String                          @db.VarChar(255)
  email      String                          @db.VarChar(255)
  token      String?                         @unique(map: "token") @db.VarChar(255)
  expires_at DateTime?                       @db.Timestamp(0)
  status     password_reset_requests_status? @default(PENDING)
  created_at DateTime?                       @default(now()) @db.Timestamp(0)
  updated_at DateTime?                       @default(now()) @db.Timestamp(0)
  users      users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_reset_requests_ibfk_1")

  @@index([user_id], map: "user_id")
}

model project_documents {
  id            Int        @id @default(autoincrement())
  project_id    String     @db.VarChar(50)
  document_name String     @db.VarChar(255)
  file_path     String     @db.VarChar(255)
  file_name     String     @db.VarChar(255)
  uploaded_by   Int?
  created_at    DateTime?  @default(now()) @db.Timestamp(0)
  updated_at    DateTime?  @default(now()) @db.Timestamp(0)
  root_cards    root_cards @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_documents_ibfk_1")

  @@index([project_id], map: "project_id")
}

