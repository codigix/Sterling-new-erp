generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model bom_materials {
  id               Int       @id @default(autoincrement())
  bom_id           Int
  item_name        String    @db.VarChar(255)
  vendor_item_name String?   @db.Text
  item_group       String?   @db.VarChar(100)
  material_grade   String?   @db.VarChar(100)
  part_detail      String?   @db.VarChar(255)
  remark           String?   @db.Text
  make             String?   @db.VarChar(100)
  quantity         Decimal?  @default(0.0000) @db.Decimal(15, 4)
  uom              String?   @db.VarChar(20)
  rate             Decimal?  @default(0.00) @db.Decimal(15, 2)
  total_amount     Decimal?  @default(0.00) @db.Decimal(15, 2)
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  warehouse        String?   @db.VarChar(255)
  operation        String?   @db.VarChar(255)
  rate_per_kg      Decimal?  @default(0.00) @db.Decimal(15, 2)
  total_weight     Decimal?  @default(0.0000) @db.Decimal(15, 4)
  length           Decimal?  @default(0.0000) @db.Decimal(15, 4)
  width            Decimal?  @default(0.0000) @db.Decimal(15, 4)
  thickness        Decimal?  @default(0.0000) @db.Decimal(15, 4)
  diameter         Decimal?  @default(0.0000) @db.Decimal(15, 4)
  outer_diameter   Decimal?  @default(0.0000) @db.Decimal(15, 4)
  height           Decimal?  @default(0.0000) @db.Decimal(15, 4)
  material_type    String?   @db.VarChar(100)
  density          Decimal?  @default(0.0000) @db.Decimal(10, 4)
  unit_weight      Decimal?  @default(0.0000) @db.Decimal(15, 4)
  side1            Decimal?  @default(0.0000) @db.Decimal(15, 4)
  side2            Decimal?  @default(0.0000) @db.Decimal(15, 4)
  web_thickness    Decimal?  @default(0.0000) @db.Decimal(15, 4)
  flange_thickness Decimal?  @default(0.0000) @db.Decimal(15, 4)
  side_s           Decimal?  @default(0.0000) @db.Decimal(15, 4)
  side_s1          Decimal?  @default(0.0000) @db.Decimal(15, 4)
  side_s2          Decimal?  @default(0.0000) @db.Decimal(15, 4)
  items_per_packet Decimal?  @default(1.0000) @db.Decimal(15, 4)
  boms             boms      @relation(fields: [bom_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bom_materials_ibfk_1")

  @@index([bom_id], map: "bom_id")
}

model bom_operations {
  id                    Int       @id @default(autoincrement())
  bom_id                Int
  operation_name        String    @db.VarChar(255)
  type                  String?   @default("in-house") @db.VarChar(50)
  workstation           String?   @db.VarChar(255)
  target_warehouse      String?   @db.VarChar(255)
  vendor_name           String?   @db.VarChar(255)
  vendor_rate_per_unit  Decimal?  @default(0.00) @db.Decimal(15, 2)
  subcontract_warehouse String?   @db.VarChar(255)
  cycle_time            Decimal?  @default(0.0000) @db.Decimal(15, 4)
  setup_time            Decimal?  @default(0.0000) @db.Decimal(15, 4)
  hourly_rate           Decimal?  @default(0.00) @db.Decimal(15, 2)
  cost                  Decimal?  @default(0.00) @db.Decimal(15, 2)
  created_at            DateTime? @default(now()) @db.Timestamp(0)
  boms                  boms      @relation(fields: [bom_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bom_operations_ibfk_1")

  @@index([bom_id], map: "bom_id")
}

model boms {
  id                Int                 @id @default(autoincrement())
  public_id         String?             @unique(map: "idx_bom_public_id") @db.VarChar(36)
  root_card_id      String              @db.VarChar(50)
  bom_number        String              @db.VarChar(100)
  revision          Int?                @default(1)
  description       String?             @db.Text
  status            String?             @default("draft") @db.VarChar(50)
  is_active         Boolean?            @default(true)
  project_id        String?             @db.VarChar(50)
  total_cost        Decimal?            @default(0.00) @db.Decimal(15, 2)
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  updated_at        DateTime?           @default(now()) @db.Timestamp(0)
  ci_test_col       String?             @db.VarChar(100)
  bom_materials     bom_materials[]
  bom_operations    bom_operations[]
  root_cards        root_cards          @relation(fields: [root_card_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "boms_ibfk_1")
  material_requests material_requests[]

  @@unique([bom_number, revision], map: "unique_bom_rev")
  @@index([root_card_id], map: "root_card_id")
}

model customer_invoice_items {
  id                Int               @id @default(autoincrement())
  invoice_id        Int
  description       String            @db.Text
  hsn_code          String?           @db.VarChar(50)
  qty               Decimal           @db.Decimal(15, 3)
  unit              String?           @db.VarChar(20)
  rate              Decimal           @db.Decimal(15, 2)
  amount            Decimal           @db.Decimal(15, 2)
  customer_invoices customer_invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_invoice_items_ibfk_1")

  @@index([invoice_id], map: "invoice_id")
}

model customer_invoices {
  id                     Int                       @id @default(autoincrement())
  public_id              String?                   @unique(map: "idx_ci_public_id") @db.VarChar(36)
  invoice_number         String                    @unique(map: "invoice_number") @db.VarChar(50)
  customer_name          String                    @db.VarChar(255)
  project_id             String?                   @db.VarChar(50)
  invoice_date           DateTime                  @db.Date
  place_of_supply        String?                   @db.VarChar(100)
  sub_total              Decimal?                  @default(0.00) @db.Decimal(15, 2)
  taxable_value          Decimal?                  @default(0.00) @db.Decimal(15, 2)
  cgst_amount            Decimal?                  @default(0.00) @db.Decimal(15, 2)
  sgst_amount            Decimal?                  @default(0.00) @db.Decimal(15, 2)
  igst_amount            Decimal?                  @default(0.00) @db.Decimal(15, 2)
  grand_total            Decimal?                  @default(0.00) @db.Decimal(15, 2)
  paid_amount            Decimal?                  @default(0.00) @db.Decimal(15, 2)
  balance_amount         Decimal?                  @default(0.00) @db.Decimal(15, 2)
  round_off              Decimal?                  @default(0.00) @db.Decimal(15, 2)
  notes                  String?                   @db.Text
  status                 customer_invoices_status? @default(PENDING)
  created_at             DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                 @default(now()) @db.Timestamp(0)
  customer_address       String?                   @db.Text
  customer_state_code    String?                   @db.VarChar(10)
  customer_gstin         String?                   @db.VarChar(50)
  gst_tds                Decimal?                  @default(0.00) @db.Decimal(15, 2)
  it_tds                 Decimal?                  @default(0.00) @db.Decimal(15, 2)
  challan_number         String?                   @db.VarChar(50)
  challan_date           DateTime?                 @db.Date
  po_number              String?                   @db.VarChar(50)
  po_date                DateTime?                 @db.Date
  transporter            String?                   @db.VarChar(100)
  lr_number              String?                   @db.VarChar(50)
  customer_invoice_items customer_invoice_items[]
  customer_payments      customer_payments[]
}

model customer_payments {
  id                Int                       @id @default(autoincrement())
  receipt_number    String                    @unique(map: "receipt_number") @db.VarChar(50)
  invoice_id        Int?
  customer_name     String                    @db.VarChar(255)
  received_date     DateTime                  @db.Date
  amount_received   Decimal                   @db.Decimal(15, 2)
  payment_method    String?                   @db.VarChar(50)
  transaction_ref   String?                   @db.VarChar(100)
  notes             String?                   @db.Text
  status            customer_payments_status? @default(COMPLETED)
  created_at        DateTime?                 @default(now()) @db.Timestamp(0)
  gst_tds           Decimal?                  @default(0.00) @db.Decimal(15, 2)
  it_tds            Decimal?                  @default(0.00) @db.Decimal(15, 2)
  customer_invoices customer_invoices?        @relation(fields: [invoice_id], references: [id], onUpdate: NoAction, map: "customer_payments_ibfk_1")

  @@index([invoice_id], map: "invoice_id")
}

model daily_operator_assignments {
  id                       Int                                         @id @default(autoincrement())
  plan_id                  Int
  root_card_id             String?                                     @db.VarChar(50)
  material_entry_no        String?                                     @db.VarChar(255)
  operation_id             Int?
  operation_name           String?                                     @db.VarChar(255)
  assignment_type          daily_operator_assignments_assignment_type? @default(inhouse)
  operator_name            String?                                     @db.VarChar(255)
  operator_id              Int?
  vendor_name              String?                                     @db.VarChar(255)
  vendor_id                Int?
  start_time               DateTime?                                   @db.Time(0)
  end_time                 DateTime?                                   @db.Time(0)
  break_time               Int?                                        @default(0)
  total_hours              Decimal?                                    @db.Decimal(5, 2)
  remarks                  String?                                     @db.Text
  status                   daily_operator_assignments_status?          @default(Pending)
  created_at               DateTime?                                   @default(now()) @db.Timestamp(0)
  daily_production_plans   daily_production_plans                      @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "daily_operator_assignments_ibfk_1")
  daily_production_updates daily_production_updates[]

  @@index([plan_id], map: "plan_id")
}

model daily_production_plans {
  id                         Int                            @id @default(autoincrement())
  plan_date                  DateTime                       @db.Date
  created_by                 Int?
  status                     daily_production_plans_status? @default(Draft)
  remarks                    String?                        @db.Text
  created_at                 DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at                 DateTime?                      @default(now()) @db.Timestamp(0)
  daily_operator_assignments daily_operator_assignments[]
  daily_production_updates   daily_production_updates[]
  material_cutting_reports   material_cutting_reports[]
}

model daily_production_updates {
  id                         Int                                       @id @default(autoincrement())
  work_date                  DateTime                                  @db.Date
  plan_id                    Int?
  assignment_id              Int?
  root_card_id               String?                                   @db.VarChar(50)
  operation_id               Int?
  operation_name             String?                                   @db.VarChar(255)
  assignment_type            daily_production_updates_assignment_type? @default(inhouse)
  operator_name              String?                                   @db.VarChar(255)
  operator_id                Int?
  vendor_name                String?                                   @db.VarChar(255)
  vendor_id                  Int?
  actual_start               DateTime?                                 @db.Time(0)
  actual_end                 DateTime?                                 @db.Time(0)
  break_time                 Int?                                      @default(0)
  actual_hours               Decimal?                                  @db.Decimal(5, 2)
  qty_completed              Decimal?                                  @default(0.00) @db.Decimal(10, 2)
  pending_qty                Decimal?                                  @default(0.00) @db.Decimal(10, 2)
  rework_qty                 Decimal?                                  @default(0.00) @db.Decimal(10, 2)
  scrap_qty                  Decimal?                                  @default(0.00) @db.Decimal(10, 2)
  status                     daily_production_updates_status?          @default(Pending)
  remarks                    String?                                   @db.Text
  created_at                 DateTime?                                 @default(now()) @db.Timestamp(0)
  daily_production_plans     daily_production_plans?                   @relation(fields: [plan_id], references: [id], onUpdate: NoAction, map: "daily_production_updates_ibfk_1")
  daily_operator_assignments daily_operator_assignments?               @relation(fields: [assignment_id], references: [id], onUpdate: NoAction, map: "daily_production_updates_ibfk_2")

  @@index([assignment_id], map: "assignment_id")
  @@index([plan_id], map: "plan_id")
}

model department_tasks {
  id              Int                        @id @default(autoincrement())
  title           String                     @db.VarChar(255)
  description     String?                    @db.Text
  department_id   Int
  priority        department_tasks_priority? @default(Medium)
  assignment_date DateTime                   @db.Date
  due_date        DateTime                   @db.Date
  status          department_tasks_status?   @default(Pending)
  assigned_by     Int?
  created_at      DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at      DateTime?                  @default(now()) @db.Timestamp(0)
  completed_date  DateTime?                  @db.DateTime(0)
  task_code       String?                    @db.VarChar(50)
  users           users?                     @relation(fields: [assigned_by], references: [id], onUpdate: NoAction, map: "department_tasks_ibfk_1")

  @@index([assigned_by], map: "assigned_by")
}

model design_documents {
  id                                        Int                      @id @default(autoincrement())
  root_card_id                              String                   @db.VarChar(50)
  name                                      String                   @db.VarChar(255)
  type                                      design_documents_type
  version                                   Int?                     @default(1)
  file_path                                 String                   @db.VarChar(255)
  description                               String?                  @db.Text
  status                                    design_documents_status? @default(Pending_Review)
  reviewer_id                               Int?
  reviewer_comment                          String?                  @db.Text
  created_by                                Int
  parent_id                                 Int?
  created_at                                DateTime?                @default(now()) @db.Timestamp(0)
  updated_at                                DateTime?                @default(now()) @db.Timestamp(0)
  dwg_path                                  String?                  @db.VarChar(255)
  step_path                                 String?                  @db.VarChar(255)
  root_cards                                root_cards               @relation(fields: [root_card_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "design_documents_ibfk_1")
  users_design_documents_created_byTousers  users                    @relation("design_documents_created_byTousers", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "design_documents_ibfk_2")
  users_design_documents_reviewer_idTousers users?                   @relation("design_documents_reviewer_idTousers", fields: [reviewer_id], references: [id], onUpdate: NoAction, map: "design_documents_ibfk_3")
  design_documents                          design_documents?        @relation("design_documentsTodesign_documents", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_parent_id")
  other_design_documents                    design_documents[]       @relation("design_documentsTodesign_documents")

  @@index([created_by], map: "created_by")
  @@index([parent_id], map: "fk_parent_id")
  @@index([reviewer_id], map: "reviewer_id")
  @@index([root_card_id], map: "root_card_id")
}

model grn_items {
  id                      Int                  @id @default(autoincrement())
  grn_id                  Int?
  po_item_id              Int
  item_code               String?              @db.VarChar(100)
  material_name           String?              @db.VarChar(255)
  ordered_qty             Decimal              @db.Decimal(15, 3)
  received_qty            Decimal              @db.Decimal(15, 3)
  received_weight         Decimal?             @default(0.0000) @db.Decimal(15, 4)
  rate_per_kg             Decimal?             @default(0.00) @db.Decimal(15, 2)
  unit                    String?              @db.VarChar(50)
  length                  Decimal?             @db.Decimal(15, 4)
  width                   Decimal?             @db.Decimal(15, 4)
  thickness               Decimal?             @db.Decimal(15, 4)
  diameter                Decimal?             @db.Decimal(15, 4)
  outer_diameter          Decimal?             @db.Decimal(15, 4)
  height                  Decimal?             @db.Decimal(15, 4)
  material_type           String?              @db.VarChar(100)
  density                 Decimal?             @default(0.0000) @db.Decimal(10, 4)
  unit_weight             Decimal?             @default(0.0000) @db.Decimal(15, 4)
  total_weight            Decimal?             @default(0.0000) @db.Decimal(15, 4)
  total_weight_alt        Decimal?             @default(0.0000) @db.Decimal(15, 4)
  item_group              String?              @db.VarChar(100)
  web_thickness           Decimal?             @default(0.0000) @db.Decimal(15, 4)
  flange_thickness        Decimal?             @default(0.0000) @db.Decimal(15, 4)
  side_s                  Decimal?             @db.Decimal(15, 4)
  side_s1                 Decimal?             @db.Decimal(15, 4)
  side_s2                 Decimal?             @db.Decimal(15, 4)
  side1                   Decimal?             @db.Decimal(15, 4)
  side2                   Decimal?             @db.Decimal(15, 4)
  items_per_packet        Float?               @default(1)
  vendor_items_per_packet Float?               @default(1)
  grns                    grns?                @relation(fields: [grn_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "grn_items_ibfk_1")
  purchase_order_items    purchase_order_items @relation(fields: [po_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "grn_items_ibfk_2")

  @@index([po_item_id], map: "po_item_id")
  @@index([grn_id], map: "receipt_id")
}

model grns {
  id                                         Int                           @id @default(autoincrement())
  public_id                                  String?                       @unique(map: "idx_grn_public_id") @db.VarChar(36)
  grn_number                                 String?                       @unique(map: "receipt_number") @db.VarChar(100)
  purchase_order_id                          Int
  vendor_id                                  Int
  posting_date                               DateTime                      @db.Date
  status                                     String?                       @default("pending") @db.VarChar(50)
  inspection_type                            grns_inspection_type?         @default(Inhouse)
  inspection_vendor_id                       Int?
  notes                                      String?                       @db.Text
  created_at                                 DateTime?                     @default(now()) @db.Timestamp(0)
  updated_at                                 DateTime?                     @default(now()) @db.Timestamp(0)
  grn_items                                  grn_items[]
  purchase_orders                            purchase_orders               @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "grns_ibfk_1")
  vendors_grns_vendor_idTovendors            vendors                       @relation("grns_vendor_idTovendors", fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "grns_ibfk_2")
  vendors_grns_inspection_vendor_idTovendors vendors?                      @relation("grns_inspection_vendor_idTovendors", fields: [inspection_vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "grns_ibfk_3")
  inventory_serials                          inventory_serials[]
  quality_final_reports                      quality_final_reports[]
  quality_inspection_challans                quality_inspection_challans[]
  quality_inspections                        quality_inspections[]
  stock_entries                              stock_entries[]

  @@index([inspection_vendor_id], map: "inspection_vendor_id")
  @@index([purchase_order_id], map: "purchase_order_id")
  @@index([vendor_id], map: "vendor_id")
}

model inventory_serials {
  id                          Int                          @id @default(autoincrement())
  serial_number               String                       @unique(map: "serial_number") @db.VarChar(100)
  item_code                   String?                      @db.VarChar(100)
  purchase_order_id           Int
  item_id                     Int
  item_name                   String                       @db.VarChar(255)
  grn_id                      Int?
  status                      inventory_serials_status?    @default(Pending)
  inspection_status           String?                      @default("Pending") @db.VarChar(50)
  inspection_challan_id       Int?
  location                    String?                      @db.VarChar(255)
  created_at                  DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at                  DateTime?                    @default(now()) @db.Timestamp(0)
  issued_in_entry_id          Int?
  length                      Decimal?                     @db.Decimal(15, 4)
  width                       Decimal?                     @db.Decimal(15, 4)
  thickness                   Decimal?                     @db.Decimal(15, 4)
  diameter                    Decimal?                     @db.Decimal(15, 4)
  outer_diameter              Decimal?                     @db.Decimal(15, 4)
  height                      Decimal?                     @db.Decimal(15, 4)
  unit_weight                 Decimal?                     @db.Decimal(15, 4)
  total_weight                Decimal?                     @db.Decimal(15, 4)
  density                     Decimal?                     @default(0.0000) @db.Decimal(10, 4)
  material_grade              String?                      @db.VarChar(100)
  item_group                  String?                      @db.VarChar(100)
  web_thickness               Decimal?                     @default(0.0000) @db.Decimal(15, 4)
  flange_thickness            Decimal?                     @default(0.0000) @db.Decimal(15, 4)
  side_s                      Decimal?                     @db.Decimal(15, 4)
  side_s1                     Decimal?                     @db.Decimal(15, 4)
  side_s2                     Decimal?                     @db.Decimal(15, 4)
  side1                       Decimal?                     @db.Decimal(15, 4)
  side2                       Decimal?                     @db.Decimal(15, 4)
  material_type               String?                      @db.VarChar(100)
  items_per_packet            Decimal?                     @default(1.0000) @db.Decimal(10, 4)
  vendor_items_per_packet     Decimal?                     @default(1.0000) @db.Decimal(10, 4)
  stock_entries               stock_entries?               @relation(fields: [issued_in_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_issued_entry")
  purchase_orders             purchase_orders              @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_serials_ibfk_1")
  purchase_order_items        purchase_order_items         @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_serials_ibfk_2")
  grns                        grns?                        @relation(fields: [grn_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_serials_ibfk_3")
  quality_inspection_challans quality_inspection_challans? @relation(fields: [inspection_challan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_serials_ibfk_4")
  quality_inspection_results  quality_inspection_results[]

  @@index([issued_in_entry_id], map: "fk_issued_entry")
  @@index([inspection_challan_id], map: "inspection_challan_id")
  @@index([item_id], map: "item_id")
  @@index([purchase_order_id], map: "purchase_order_id")
  @@index([grn_id], map: "receipt_id")
}

model inward_challan_items {
  id                Int              @id @default(autoincrement())
  inward_challan_id Int?
  item_code         String?          @db.VarChar(100)
  item_name         String?          @db.VarChar(255)
  batch_no          String?          @db.VarChar(100)
  sent_qty          Decimal?         @db.Decimal(15, 6)
  received_qty      Decimal?         @db.Decimal(15, 6)
  accepted_qty      Decimal?         @db.Decimal(15, 6)
  rejected_qty      Decimal?         @db.Decimal(15, 6)
  uom               String?          @db.VarChar(20)
  remarks           String?          @db.Text
  inward_challans   inward_challans? @relation(fields: [inward_challan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inward_challan_items_ibfk_1")

  @@index([inward_challan_id], map: "inward_challan_id")
}

model inward_challans {
  id                   Int                     @id @default(autoincrement())
  challan_no           String                  @unique(map: "challan_no") @db.VarChar(50)
  challan_date         DateTime                @db.Date
  status               inward_challans_status? @default(DRAFT)
  outward_challan_id   Int?
  vendor_id            Int?
  vendor_name          String?                 @db.VarChar(255)
  vendor_address       String?                 @db.Text
  received_date        DateTime?               @db.Date
  vehicle_no           String?                 @db.VarChar(50)
  remarks              String?                 @db.Text
  root_card_id         String?                 @db.VarChar(50)
  created_at           DateTime?               @default(now()) @db.Timestamp(0)
  updated_at           DateTime?               @default(now()) @db.Timestamp(0)
  inward_challan_items inward_challan_items[]
  outward_challans     outward_challans?       @relation(fields: [outward_challan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inward_challans_ibfk_1")

  @@index([outward_challan_id], map: "outward_challan_id")
}

model ledger_entries {
  id               Int                             @id @default(autoincrement())
